{
  "name": "promptsaver",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Simpan, atur, dan pakai ulang prompt AI secara offline",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.node.json",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hookform/resolvers": "^5",
    "@lottiefiles/dotlottie-react": "^0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-clipboard-manager": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "class-variance-authority": "^0.7.1",
    "i18next": "^26.4.2",
    "lucide-react": "^0",
    "motion": "^12",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.6.7",
    "react": "^19",
    "react-dom": "^19",
    "react-hook-form": "^7",
    "react-i18next": "^17.0.15",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "zod": "^4",
    "zustand": "^5"
  },
  "devDependencies": {
    "@eslint/js": "^9",
    "@tauri-apps/cli": "^2",
    "@testing-library/dom": "^10",
    "@testing-library/jest-dom": "^6",
    "@testing-library/react": "^16",
    "@testing-library/user-event": "^14",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^9",
    "eslint-plugin-react-hooks": "^5",
    "eslint-plugin-react-refresh": "^0",
    "globals": "^15",
    "jsdom": "^26",
    "prettier": "^3",
    "shadcn": "^4.21.0",
    "typescript": "~6",
    "typescript-eslint": "^8",
    "vite": "^8",
    "vitest": "^3"
  },
  "packageManager": "pnpm@11.27.0"
}
