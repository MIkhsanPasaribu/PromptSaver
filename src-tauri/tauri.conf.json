{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "PromptSaver",
  "version": "0.1.2",
  "identifier": "com.promptsaver.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "utama",
        "title": "PromptSaver",
        "width": 1120,
        "height": 760,
        "minWidth": 880,
        "minHeight": 560,
        "center": true,
        "resizable": true,
        "decorations": true,
        "alwaysOnTop": false,
        "visible": true,
        "transparent": true,
        "shadow": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-ancestors 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Simpan dan pakai ulang prompt AI tanpa internet",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "embedBootstrapper"
      },
      "nsis": {
        "template": "windows/installer.nsi",
        "sidebarImage": "windows/assets/sidebar.bmp",
        "headerImage": "windows/assets/header.bmp",
        "uninstallerHeaderImage": "windows/assets/uninstaller-header.bmp",
        "installerIcon": "icons/icon.ico",
        "uninstallerIcon": "icons/icon.ico",
        "languages": ["Indonesian", "English"],
        "installMode": "currentUser",
        "displayLanguageSelector": true,
        "customLanguageFiles": {
          "Indonesian": "windows/languages/Indonesian.nsh"
        },
        "startMenuFolder": "PromptSaver"
      }
    },
    "fileAssociations": [
      {
        "ext": ["promptsaver"],
        "mimeType": "application/x-promptsaver",
        "description": "Koleksi PromptSaver",
        "role": "Viewer"
      }
    ]
  }
}
