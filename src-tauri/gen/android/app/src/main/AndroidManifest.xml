<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Tidak ada izin INTERNET di manifest utama. Izin itu hanya boleh hidup di
         src/debug/AndroidManifest.xml supaya build rilis benar-benar tanpa jaringan
         (AGENTS.md Bagian 7). -->

    <!-- AndroidTV support -->
    <uses-feature android:name="android.software.leanback" android:required="false" />

    <application
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/Theme.promptsaver"
        android:usesCleartextTraffic="${usesCleartextTraffic}">
        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:launchMode="singleTask"
            android:label="@string/main_activity_title"
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
                <!-- AndroidTV support -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>

            <!-- Ditulis tangan, di luar blok yang digenerasi Tauri supaya tidak ditimpa.
                 Sebagian besar pengelola berkas mengirim .promptsaver sebagai
                 application/octet-stream karena ekstensinya tidak terdaftar di sistem; tanpa
                 filter ini intent VIEW tidak ter-resolve sama sekali (terukur di emulator API 36).
                 Satu entri fileAssociations ganda tidak bisa dipakai karena Tauri menghasilkan
                 ProgId WiX duplikat dan light.exe gagal. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="content" android:mimeType="application/octet-stream" />
                <data android:scheme="file" android:mimeType="application/octet-stream" />
                <data android:scheme="content" android:mimeType="text/plain" android:pathPattern=".*\\.promptsaver" />
            </intent-filter>
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <action android:name="android.intent.action.SEND_MULTIPLE" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="application/x-promptsaver" />
                <data android:pathPattern=".*\\.promptsaver" />
            </intent-filter>
            
            <!-- tauri-file-associations. AUTO-GENERATED. DO NOT REMOVE. -->
        </activity>

        <provider
          android:name="androidx.core.content.FileProvider"
          android:authorities="${applicationId}.fileprovider"
          android:exported="false"
          android:grantUriPermissions="true">
          <meta-data
            android:name="android.support.FILE_PROVIDER_PATHS"
            android:resource="@xml/file_paths" />
        </provider>
    </application>
</manifest>
